{
    "$schema": "https://json.schemastore.org/claude-code-settings.json",
    "permissions": {
        "allow": [
            "Bash(npm run build)",
            "Bash(npm run validate)",
            "Bash(npm run preview)",
            "Bash(npm run screenshot)",
            "Bash(mkdir -p *)",
            "Bash(cp *)",
            "Bash(grep *)",
            "Bash(cat *)",
            "Bash(find *)"
        ],
        "ask": [
            "Bash(git add *)",
            "Bash(git commit *)",
            "Bash(git push *)",
            "Bash(npm install *)",
            "Bash(npx playwright *)"
        ],
        "deny": [
            "Read(./.env)",
            "Read(./.env.*)",
            "Read(./secrets/**)",
            "Bash(rm -rf *)",
            "Bash(curl *)",
            "Bash(wget *)"
        ],
        "defaultMode": "default"
    }
}